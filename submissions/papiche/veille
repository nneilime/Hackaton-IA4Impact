# Raccourci : ./veille ask "..."  équivaut à  python -m veille_reglementaire ask "..."
cd "$(dirname "$0")"
PY="${VEILLE_PYTHON:-python3}"
[ -x "$HOME/.astro/bin/python3" ] && [ -z "${VEILLE_PYTHON:-}" ] && PY="$HOME/.astro/bin/python3"
exec "$PY" -m veille_reglementaire "$@"
