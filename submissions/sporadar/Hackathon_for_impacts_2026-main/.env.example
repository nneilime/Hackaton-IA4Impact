# =============================================================================
#  VARIABLES D'ENVIRONNEMENT - SOURCE UNIQUE POUR TOUT LE PROJET
# =============================================================================
#  Ce fichier est un MODELE, il est commité dans git (sans secret).
#
#  Pour démarrer :   cp .env.example .env     (puis ajuster les valeurs)
#  Le vrai fichier `.env` n'est JAMAIS commité (il contient des mots de passe).
#
#  Qui lit quoi ?
#    - docker-compose.yml  -> lit ce fichier automatiquement
#    - back (conteneur)    -> reçoit toutes les variables via `env_file`
#    - front (Angular)     -> seules les variables FRONT_* sont utilisées
#                             (voir frontend/scripts/generate-env.mjs)
#
#  ATTENTION : tout ce qui commence par FRONT_ finit dans le JavaScript envoyé
#  au navigateur, donc PUBLIC. Ne jamais y mettre de secret.
# =============================================================================

# --- Docker (général) --------------------------------------------------------
# Préfixe des noms de conteneurs/réseaux/volumes (évite les collisions entre projets)
COMPOSE_PROJECT_NAME=lallemand

# --- Front (Angular) ---------------------------------------------------------
# Port exposé sur ta machine : http://localhost:8080
FRONT_PORT=8080
# URL de l'API vue depuis le navigateur.
# "/api" = le nginx du front redirige vers le back (pas de CORS à gérer).
FRONT_API_URL=/api
# Où le front envoie les appels /api : proxy de dev (pnpm start) ET nginx (Docker). SANS /api à la fin.
# Vide = le back local / Docker (http://localhost:BACK_PORT ou http://backend:BACK_PORT).
# Back d'équipe déployé : BACK_URL=http://64.176.83.254:3000
# Renseigné => le navigateur appelle le back EN DIRECT (BACK_URL/api), sans le proxy nginx (build du front : relancer avec --build).
# Attention : si le front est servi en https, BACK_URL doit être en https aussi (sinon le navigateur bloque le contenu mixte).
BACK_URL=

# --- Back (technologie à définir) -------------------------------------------
# Port sur lequel l'application back écoute DANS son conteneur
BACK_PORT=3000
# Port exposé sur ta machine pour tester le back en direct : http://localhost:3000
BACK_HOST_PORT=3000
APP_ENV=production

# --- Base de données (MySQL) -------------------------------------------------
# Ces noms (MYSQL_*) sont ceux attendus par l'image officielle mysql : le
# conteneur les lit directement depuis ce fichier. Le back peut les réutiliser.
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_DATABASE=lallemand
MYSQL_USER=lallemand
MYSQL_PASSWORD=change-me

# Où le back joint la base. "db" = nom du service dans docker-compose.yml.
# Entre conteneurs, on s'appelle par le NOM DU SERVICE, pas par "localhost".
DB_HOST=db
DB_PORT=3306
# --- IA (fournisseur interchangeable, optionnel : sans clé = mode dégradé) ---
AI_PROVIDER=replace_me
AI_BASE_URL=
AI_MODEL=replace_me
# Modèle de secours (facultatif) : essayé si le modèle principal échoue encore après les nouvelles tentatives
AI_FALLBACK_MODEL=
AI_API_KEY=

# --- Base PostgreSQL (api/ et scripts/load_db.py) ---------------------------
# Exemple : postgresql+psycopg://user:password@localhost:5432/lallemand
DATABASE_URL=

# --- API (backend/app) -------------------------------------------------------
# Clé partagée pour l'en-tête X-API-Key. VIDE = accès libre (dev local). Renseignée = obligatoire
# sur toutes les routes sauf /health. A renseigner pour le tunnel public Power Platform.
API_KEY=
