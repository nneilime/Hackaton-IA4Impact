{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "env": "node scripts/generate-env.mjs",
    "mock": "prism mock -p 4010 ../openapi.proposed.yaml",
    "start": "node scripts/generate-env.mjs && ng serve --proxy-config proxy.back.mjs",
    "start:mock": "concurrently -k -n prism,app -c cyan,green \"pnpm mock\" \"node scripts/generate-env.mjs --mock && ng serve --proxy-config proxy.mock.mjs\"",
    "build": "node scripts/generate-env.mjs && ng build",
    "watch": "node scripts/generate-env.mjs && ng build --watch --configuration development",
    "test": "node scripts/generate-env.mjs && node scripts/build-mocks.mjs && ng test --no-watch",
    "gen:api": "openapi-typescript ../openapi.proposed.yaml -o src/app/core/api/schema.d.ts",
    "gen:mocks": "node scripts/build-mocks.mjs"
  },
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ng-icons/core": "^32.2.0",
    "@ng-icons/lucide": "^32.2.0",
    "@spartan-ng/brain": "^1.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "postcss": "^8.5.29",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@spartan-ng/cli": "^1.6.3",
    "@stoplight/prism-cli": "5.14.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  }
}
