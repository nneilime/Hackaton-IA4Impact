# Copier en .env (ignoré par git). Ne jamais committer .env.
# Tout passe par l'API Gemini (Google) : modèle de langage (réponses, choix des fiches FAQ) et dictée.
GEMINI_API_KEY=

# Facultatif
# ASSISTANT_MODEL=gemini-3.8-flash
# ASSISTANT_FALLBACK_MODEL=gemini-3.7-flash
# ASSISTANT_REASONING_EFFORT=low          # low (rapide, économe), medium ou high
# ASSISTANT_STT_MODEL=gemini-3.5-transcribe
# ASSISTANT_STT_FALLBACK_MODEL=gemini-3.8-flash
# ASSISTANT_TTS=piper           # piper (voix locale) ou edge (voix Microsoft, actuellement refusée)
# ASSISTANT_HOST=127.0.0.1
# ASSISTANT_PORT=8000
