    "@fontsource-variable/sora": "^5.3.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
